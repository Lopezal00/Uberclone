# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# Puerto del servidor
PORT=3000

# Mercado Pago > Tus integraciones > tu aplicación > Credenciales de PRUEBA > Access Token
MP_ACCESS_TOKEN=

# Mercado Pago > Tus integraciones > Webhooks > Clave secreta (opcional: si está, se valida la firma)
MP_WEBHOOK_SECRET=

# Dirección pública HTTPS del backend (por ejemplo la de un túnel). Opcional:
# si está vacía, no hay webhook y el pago se verifica desde la app con "Verificar pago".
PUBLIC_URL=

# Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# Guarda el JSON en esta carpeta con este nombre (ya está en .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
